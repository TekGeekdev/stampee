{{ include('layouts/header.twig', {title:'Mes timbres'})}}
<main id="cont-princ-aside-avec-main">
	<section class="galerie">
		<header>
			<h2>Galerie philatélique</h2>
			<div>
				<label for="triage">Triez par :
					<select name="pays-edition" id="triage" class="input-selection variante-bleu">
						<option value="" selected disabled>choisissez un type</option>
						<option value="alphabetAsc">Ordre A-Z</option>
						<option value="AlphabetDesc">Ordre Z-A</option>
						<option value="prixAsc">Prix croissant</option>
						<option value="prixDesc">Prix décroissant</option>
						<option value="tempsCourt">Temps restant le plus court</option>
						<option value="tempsLong">Temps restant le plus long</option>
						<option value="dateAnc">Date d'émission la plus ancienne</option>
						<option value="dateRec">Date d'émission la plus récente</option>
					</select>
				</label>

				<label for="format-carte" class="input-hover">
					<i class="fa-solid fa-border-all fa-lg"></i>
					Cartes
					<input type="radio" id="format-carte" name="view" checked>
				</label>
				<label for="format-liste" class="input-hover">
					<i class="fa-solid fa-list fa-lg"></i>
					Liste
					<input type="radio" id="format-liste" class="format-liste" name="view">
				</label>
			</div>
		</header>
		<div class="cartes">
			{% for auction in auctions %}
				<article class="carte zoomEffet ombre-boite">
					<div class="carte-img-avec-favoris">
						<img class="carte-timbre-image" src="{{uploads}}{{auction.fileName}}" alt="image d'un timbre">
						<input class="carte-timbre-favoris" type="checkbox" name="favoris" aria-label="icone pour mettre une enchère en favoris">
					</div>
					<div class="carte-zone-txt">
						<div class="txt-enchere-ligne">
							<p class="timbre-status">Titre enchère</p>
							<p class="timbre-lot">{{auction.name}}</p>
						</div>
						<div class="entete-enchere">
							<h3 class="timbre-titre">{{auction.nameStamp}}</h3>
							<div class="txt-enchere-colonne">
								<div class="txt-enchere-ligne">
									<p class="timbre-annee">Année d'émission :</p>
									<p>{{auction.dateRelease}}</p>
								</div>
								<div class="txt-enchere-ligne">
									<p class="timbre-etat">État :</p>
									<p>{{auction.condition}}</p>
								</div>
							</div>
						</div>
						<div class="txt-enchere-colonne">
							<div class="txt-enchere-ligne">
								<p class="timbre-prix">
									<b>Mise actuelle :</b>
								</p>
								<p>
									<b>{{auction.startPrice}}
										$</b>
								</p>
							</div>
							<div class="txt-enchere-ligne">
								<p class="timbre-temps-restant">
									<b>Temps restant :</b>
								</p>
								<p class="texte-vert">
									<b>3 jours 21 heures</b>
								</p>
							</div>
						</div>
						<form action="{{base}}/bid/store" class="mise">
							<input type="hidden" name="id" value="{{auction.id}}">
							<input type="number" name="bid" min="{{auction.startPrice + 1 }}" class="input-selection variante-bleu" placeholder="Entrez une mise" aria-label="Entrez une mise pour l'action">
							<input type="submit" value="Miser" class="bouton">
						</form>
                        {% if auction.id == bidData.id %}
                                {% if errors.bid is defined %}
								<span class="span-erreur">
									{{errors.bid}}</span>
							{% endif %}
                            {% endif %}
						<a href="{{base}}/auction/show?id={{auction.id}}">Voir détails de l'offre</a>
					</div>
				</article>
			{% endfor %}
		</div>
	</section>
	<aside class="filtres">
		<form action="index.html">
			<h2>Filtres</h2>
			<section class="filtres-vertical tiroir-vertical">
				<details>
					<summary>
						<h3>État des timbres</h3>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5"/>
						</svg>
					</summary>
					<div>
						<label for="inutilise">Inutilisé</label>
						<input type="radio" name="etat-timbre" id="inutilise">
					</div>
					<div>
						<label for="utilise">Utilisé</label>
						<input type="radio" name="etat-timbre" id="utilise">
					</div>
					<div>
						<label for="oblitere">Oblitéré</label>
						<input type="radio" name="etat-timbre" id="oblitere">
					</div>
					<div>
						<label for="sans-gomme">Sans gomme</label>
						<input type="radio" name="etat-timbre" id="sans-gomme">
					</div>
					<div>
						<label for="deteriore">Détérioré</label>
						<input type="radio" name="etat-timbre" id="deteriore">
					</div>
					<div>
						<label for="repare">Réparé</label>
						<input type="radio" name="etat-timbre" id="repare">
					</div>
					<div>
						<label for="tache">Taché</label>
						<input type="radio" name="etat-timbre" id="tache">
					</div>
					<div>
						<label for="mal-centre">Mal centré</label>
						<input type="radio" name="etat-timbre" id="mal-centre">
					</div>
				</details>
			</section>
			<section>
				<h3>Mise à prix</h3>
				<div>
					<label for="minimum">Minimum</label>
					<input type="number" name="minimum" id="minimum" placeholder="Mise minimum" class="input-selection variante-bleu">
				</div>
				<p>&</p>
				<div>
					<label for="maximum">Maximum</label>
					<input type="number" name="maximum" id="maximum" placeholder="Mise maximum" class="input-selection variante-bleu">
				</div>
			</section>
			<section class="select-a-droite">
				<h3>Pays d'édition</h3>
				<select name="pays-edition" class="input-selection variante-bleu" aria-label="filtre pays édition">
					<option value="" selected disabled>Sélectionner un pays</option>
					<option value="US">États-Unis</option>
					<option value="france">France</option>
					<option value="allemagne">Allemagne</option>
					<option value="suisse">Suisse</option>
					<option value="chine">Chine</option>
					<option value="japon">Japon</option>
					<option value="canada">Canada</option>
					<option value="italie">Italie</option>
					<option value="russie">Russie</option>
				</select>
			</section>
			<section class="filtres-vertical">
				<h3>Rareté</h3>
				<div>
					<label for="ordinaire">Ordinaire</label>
					<input type="checkbox" name="ordinaire" id="ordinaire">
				</div>
				<div>
					<label for="rarete">Rareté</label>
					<input type="checkbox" name="rarete" id="rarete">
				</div>
				<div>
					<label for="faux">Faux ou imitation</label>
					<input type="checkbox" name="faux" id="faux">
				</div>
				<div>
					<label for="variant-erreur">Variante ou erreur</label>
					<input type="checkbox" name="variant-erreur" id="variant-erreur">
				</div>
				<div>
					<label for="essai">Essai</label>
					<input type="checkbox" name="essai" id="essai">
				</div>
				<div>
					<label for="particularite">Particularité</label>
					<input type="checkbox" name="particularite" id="particularite">
				</div>
				<div>
					<label for="collection">Dans une collection</label>
					<input type="checkbox" name="collection" id="collection">
				</div>
				<div>
					<label for="isole">Isolé</label>
					<input type="checkbox" name="isole" id="isole">
				</div>
			</section>
			<input type="submit" value="Rechercher" class="bouton">
			<input type="reset" value="Réinitialiser les filtres" class="bouton as-secondary-btn">
		</form>
	</aside>
	{{ include('template/up-page.twig')}}
</main>

